# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Your GitHub user or organization (images come from ghcr.io/<owner>/smoker-matchmaker)
GITHUB_OWNER=your-github-username
APP_TAG=latest

# Database password: long and random, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=change-me

# First start only: creates the organization and first admin if the database is empty.
# The admin must choose a new password at first sign-in. Remove these afterwards.
BOOTSTRAP_ORG_NAME=My Promotions
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_NAME=Your Name
BOOTSTRAP_ADMIN_PASSWORD=temporary-password-123

# Your Tailscale address, if requests are refused as cross-site (see docs/deploy.md)
# ALLOWED_ORIGINS=https://matchmaker.your-tailnet.ts.net
